# ============================================
# Configuração do Ollama LLM
# ============================================

# URL do serviço Ollama
OLLAMA_BASE_URL=http://localhost:11434

# Modelo a ser utilizado
# Modelos leves recomendados: qwen2:0.5b, tinyllama, llama3.2
OLLAMA_MODEL=qwen2:0.5b

# Timeout em segundos para requisições ao Ollama (1-600)
# Primeira requisição pode demorar mais (carregamento do modelo)
OLLAMA_TIMEOUT=180.0

# Número máximo de tentativas em caso de falha (1-10)
OLLAMA_MAX_RETRIES=3


# ============================================
# Rate Limiting
# ============================================

# Limite de requisições para /extract-incident
# Formato: N/period (period: second, minute, hour, day)
RATE_LIMIT_EXTRACT=10/minute

# Limite padrão para outros endpoints
RATE_LIMIT_DEFAULT=60/minute


# ============================================
# Logging
# ============================================

# Nível de log: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Nome do serviço para logs estruturados
SERVICE_NAME=incident-extractor


# ============================================
# Configuração da API
# ============================================

# Título da API para documentação
API_TITLE=Incident Information Extractor API

# Versão da API
API_VERSION=1.0.0

# Origens permitidas para CORS (separadas por vírgula)
# Use "*" para permitir todas as origens (desenvolvimento)
CORS_ORIGINS=*


# ============================================
# Validação de Resposta do LLM
# ============================================

# Habilita validação de schema na resposta do LLM
# true: valida campos esperados (recomendado)
# false: aceita qualquer JSON retornado
VALIDATE_LLM_RESPONSE=true

# Permite respostas com campos faltando (serão preenchidos com null)
# true: aceita respostas parciais (recomendado)
# false: rejeita se algum campo obrigatório estiver faltando
ALLOW_PARTIAL_RESPONSE=true
